# PocketShift AI — environment configuration (copy to .env; never commit real values)

# --- AWS Bedrock (optional; app runs fully without it) ---
# Credentials are discovered from the environment, a local AWS profile, or an
# attached role. Do NOT paste secret keys here. Prefer `aws configure` / SSO.
AWS_REGION=eu-central-1

# Bedrock model id. Verify access with:
#   aws bedrock list-foundation-models --region eu-central-1
# Leave blank to let the app auto-pick an accessible model, or set explicitly, e.g.:
#   eu.anthropic.claude-sonnet-4-5-20250929-v1:0
POCKETSHIFT_BEDROCK_MODEL_ID=

# Set to 1 to force-disable the AI agent (deterministic fallback only).
POCKETSHIFT_DISABLE_BEDROCK=0
